{
  "name": "banjir-ready",
  "version": "0.0.0",
  "private": true,
  "description": "Credential-free, offline-capable flood preparedness MVP for Malaysia.",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @banjir-ready/web",
    "dev:server": "npm run dev --workspace @banjir-ready/server",
    "start": "npm run start --workspace @banjir-ready/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "tsc --build --force --pretty false && npm run build --workspace @banjir-ready/web",
    "demo-acceptance": "npm run demo-acceptance --workspace @banjir-ready/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.19.0",
    "@playwright/test": "1.50.1",
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.5",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "fast-check": "3.23.2",
    "jsdom": "26.0.0",
    "postcss": "8.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  },
  "packageManager": "npm@10.9.2"
}

